# Never commit the real values.
WEIBO_COOKIE=
DOUYIN_COOKIE=

# Optional API protection. Strongly recommended when not bound to 127.0.0.1.
MEDIA_COLLECTOR_API_KEY=

# Comma-separated origins. Empty means that browser CORS is disabled.
MEDIA_COLLECTOR_CORS_ORIGINS=

# Public URL of the exact source version offered to network users.
MEDIA_COLLECTOR_SOURCE_URL=

# Keep disabled for untrusted clients. When unset, save_dir must remain under
# the configured download root.
MEDIA_COLLECTOR_ALLOW_CUSTOM_SAVE_DIRS=0
